# Copy this to .env.local and fill in your values.

# Supabase — create a project at https://supabase.com (free tier).
# Both vars come from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key

# ─── AI provider ────────────────────────────────────────────────────
# Pluggable. Defaults to xAI Grok if AI_PROVIDER is unset.
# Options: xai (default) | openai | anthropic | google | gateway
# AI_PROVIDER=xai

# xAI Grok — sign up at https://console.x.ai (free tier on signup).
XAI_API_KEY=xai-...

# Other providers — uncomment and set the matching key + AI_PROVIDER above.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_GENERATIVE_AI_API_KEY=...
# AI_GATEWAY_API_KEY=vck_...

# Optional model overrides (per role). Sensible defaults per provider apply
# when these are unset; see README → "Choosing an AI provider".
# AI_MODEL_FAST=gpt-4o-mini
# AI_MODEL_BULK=grok-3-fast            # used by the plan-week generator;
                                       # falls back to AI_MODEL_FAST when unset.
                                       # Swap to a faster non-reasoning model
                                       # if 21-meal plans are timing out.
# AI_MODEL_VISION=gpt-4o-mini
# AI_MODEL_IMAGE=dall-e-3

# Optional sampling controls. Kept consistent across providers so swapping
# AI_PROVIDER doesn't change output style. Defaults: temperature=0.4, no seed.
# AI_TEMPERATURE=0.4
# AI_SEED=42

# Live web search behavior. Default: ON for xAI (the photo passthrough chain
# leans on the model returning image_url from search, so leaving it off means
# we always fall through to Brave/Pexels). Each xAI search costs ~$0.025;
# ~21 searches per week-plan generation. Set true to opt out:
# AI_DISABLE_SEARCH=true

# ─── Photos ─────────────────────────────────────────────────────────
# Recipe photo resolution chain:
#   1. og:image from the recipe's source page (URL-parsed recipes)
#   2. Brave web image search       (set BRAVE_SEARCH_API_KEY)
#   3. Pexels search                 (set PEXELS_API_KEY)
#   4. AI image generation           (uses your AI_PROVIDER's image model)
#   5. Stylised SVG fallback (always available)
#
# Each layer is optional — leave keys unset to skip. Get keys at:
#   Brave:   https://api.search.brave.com   (free tier 2k queries/month)
#   Pexels:  https://www.pexels.com/api/    (free tier, generous)
# BRAVE_SEARCH_API_KEY=...
# PEXELS_API_KEY=...

# ─── Nutrition data ─────────────────────────────────────────────────
# USDA FoodData Central API. Free, 1k requests/hour. Used to refine
# AI-generated recipe macros against real USDA per-100g values when
# we can match ingredients with high confidence — the AI's estimate
# is kept as a fallback when coverage is too low to trust. Get a key
# at https://fdc.nal.usda.gov/api-key-signup.html
# USDA_API_KEY=...

# ─── Grocery store integration ──────────────────────────────────────
# Kroger Public API. When set:
#   /me shows a store picker (search by ZIP) and a Kroger-cart connect
#   /shop shows real per-item prices + aisle numbers from your store
#   /shop "Send to Kroger Cart" pushes the list to the user's cart
#
# Register an app at https://developer.kroger.com — Personal App tier
# is free. Check Cart + Locations + Products + Profile as required
# API products. In the app's Production environment add this Redirect
# URI exactly:
#
#   {NEXT_PUBLIC_APP_URL}/api/kroger/oauth/callback
#
# (e.g. https://your-prod-domain.vercel.app/api/kroger/oauth/callback
# in production, http://localhost:3000/api/kroger/oauth/callback in
# dev). Kroger requires an exact match.
#
# Pricing cache lives in `kroger_price_cache` (24-hour TTL) to stay
# under the ~5k/day product-search quota.
# KROGER_CLIENT_ID=...
# KROGER_CLIENT_SECRET=...

# Public app URL (used for OAuth callbacks). For local dev, leave as-is.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Per-user AI cost guard (optional) ──────────────────────────────
# Hestia counts every AI call per (user, day) via the daily_ai_usage
# table and 429s requests over the cap. Default: 100 calls/user/day,
# which covers normal use (~10 typical) with a comfortable margin and
# stops a runaway loop / curious friend from racking up your AI bill.
# Set higher if you want, set to 0 for no limit (not recommended on a
# shared instance).
# AI_DAILY_LIMIT_PER_USER=100

# ─── Sign-up gate (optional) ────────────────────────────────────────
# Comma-separated email allowlist. When set, only these addresses can
# request a magic code on /login — everyone else gets a friendly note
# pointing them at the open-source repo to run their own instance.
# Leave unset for fully-open sign-up (the default).
#
# Use this on a hosted instance you only want friends/family to use,
# while still keeping the code open-source. Forks deploying their own
# Supabase + Vercel just leave it unset.
# SIGNUP_ALLOWLIST=alice@example.com,bob@example.com
